# Git attributes for BurnedChats
# https://git-scm.com/docs/gitattributes

# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.java text diff=java
*.kt text diff=kotlin
*.kts text diff=kotlin
*.gradle text diff=kotlin
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text diff=javascript
*.jsx text diff=javascript
*.css text diff=css
*.scss text diff=css
*.html text diff=html
*.xml text diff=xml

# Documentation
*.md text diff=markdown
*.txt text
*.adoc text

# Configuration
*.json text
*.yml text
*.yaml text
*.properties text
*.conf text
*.config text
.editorconfig text
.gitattributes text
.gitignore text

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text
docker-compose*.yml text

# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.properties text

# Binary files
*.jar binary
*.war binary
*.ear binary
*.class binary
*.so binary
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Lock files
package-lock.json text -diff
yarn.lock text -diff
pnpm-lock.yaml text -diff
gradle.lockfile text -diff

# Prevent merge conflicts in generated files
*.min.js binary
*.min.css binary


