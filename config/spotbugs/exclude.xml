<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        SpotBugs exclusion filter for BurnedChats project
        See: https://spotbugs.readthedocs.io/en/stable/filter.html
    -->

    <!-- Exclude generated code -->
    <Match>
        <Source name="~.*Generated.*\.java"/>
    </Match>

    <!-- Exclude test classes (incl. nested/anonymous and *IT) from certain checks -->
    <Match>
        <Class name="~.*(Test|IT)(\$.*)?"/>
        <Or>
            <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
            <Bug pattern="URF_UNREAD_FIELD"/>
            <!-- Tests deliberately pass null / stub @Nonnull APIs with null returns -->
            <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
            <Bug pattern="NP_NONNULL_RETURN_VIOLATION"/>
            <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
            <!-- BlockingQueue.offer() result is irrelevant in unbounded test sinks -->
            <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
        </Or>
    </Match>

    <!--
        Spring/Lombok/SpotBugs: false positives for DI, @ConfigurationProperties, DTOs, etc.
    -->
    <Match>
        <Package name="~dev\.burnedchats\..*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="MS_EXPOSE_REP"/>
            <Bug pattern="NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
            <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
            <Bug pattern="CT_CONSTRUCTOR_THROW"/>
            <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
        </Or>
    </Match>

    <!-- Allow certain patterns in configuration classes -->
    <Match>
        <Class name="~.*Config"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>

    <!-- Spring-specific exclusions -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>

    <!-- Exclude MapStruct generated mappers -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <!-- Allow null checks in reactive code -->
    <Match>
        <Package name="~dev\.burnedchats\..*"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- Serialization warnings for DTOs -->
    <Match>
        <Class name="~.*Dto"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <Match>
        <Class name="~.*Request"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <Match>
        <Class name="~.*Response"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- Exclude certain patterns in exception classes -->
    <Match>
        <Class name="~.*Exception"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
</FindBugsFilter>

