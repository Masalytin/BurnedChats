# ===========================================
# BurnedChats Production Environment Variables
# ===========================================
# Copy this file to .env.prod and fill in the values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ===== Domain =====
# Your domain name (without https://)
DOMAIN=burnedchats.net

# ===== Redis =====
# Generate a strong password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ===== Telegram Bot =====
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=BurnedChatsBot

# Webhook secret for security (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET

# ===== TON wallet auth (optional — toncenter fallback only) =====
# Primary verification uses account.publicKey + walletStateInit from TON Connect (see frontend).
# BURNEDCHATS_TON_API_KEY=
# BURNEDCHATS_TON_API_BASE_URL=https://toncenter.com/api/v2
# BURNEDCHATS_WALLET_DOMAIN=burnedchats.net

# ===== Optional =====
# Server port (usually 8080)
# SERVER_PORT=8080

# Log path inside container
# LOG_PATH=/app/logs


# ===== TON (testnet prod — current default in docker-compose.prod.yml) =====
# After contracts deploy: npm run deploy:jetton:testnet → sync from contracts/deployments/testnet.json
TONCENTER_API_KEY=<testnet-key-from-toncenter.com>
BURN_JETTON_MASTER_ADDRESS=PENDING_POST_DEPLOY

# Optional overrides (defaults in docker-compose.prod.yml suit testnet prod):
# SPRING_PROFILES_ACTIVE=prod,testnet
# TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2
# BURNEDCHATS_TON_API_BASE_URL=https://testnet.toncenter.com/api/v2

# Post-deploy burn transfer smoke (scripts/post-deploy-burn-transfer-smoke.sh)
# Known testnet wallet with BURN balance — used as --owner default; not a secret
# BURN_SMOKE_TEST_OWNER=0QBNxdjqjhQP2OPaZHSRj06NRTd4z6-Trd6BdZ0DX0_9WJPD

# Mainnet (future): SPRING_PROFILES_ACTIVE=prod, TONCENTER_ENDPOINT=https://toncenter.com/api/v2,
# BURNEDCHATS_TON_API_BASE_URL=https://toncenter.com/api/v2, and mainnet contract addresses
