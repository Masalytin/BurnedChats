# BurnedChats .gitignore

# ========================
# Build artifacts & caches (do not commit)
# ========================
# Gradle — project root and any nested projects
.gradle/

# Backend (Spring / Gradle)
backend/build/
backend/bin/

# Frontend (Vite)
frontend/dist/
frontend/dist-ssr/

# Contracts (Node tooling; see also contracts/.gitignore)
contracts/build/

# Node — any package in the repo
node_modules/

# Catch-all for other tooling output (Vite cache, nested packages, etc.)
**/dist/
out/

# ========================
# IDE and Editor
# ========================
.idea/
.cursor/
.cursorignore
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ========================
# Java / Gradle (artifacts not tied to one directory)
# ========================
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# JAR files (keep Gradle wrapper)
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Any other Gradle `build/` dirs (future modules) — after explicit paths above
**/build/
!gradle/wrapper/

# Maven (if ever used)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ========================
# TON contracts (contracts/) — env & tooling
# ========================
contracts/node_modules/
contracts/.env

# ========================
# Node.js logs & stores
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next / Nuxt / caches
.next/
.nuxt/
.cache/

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.prod
# Catch-all for any .env.* variant (.env.lab, .env.mainnet, ...) — env files may hold secrets
.env.*
*.env
!.env.example
# Tracked exception: contains ONLY public testnet contract addresses, no secrets [P5-6-1-1]
!frontend/.env.testnet

# Let's Encrypt certificates
certbot/

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
*.jks
!certs/README.md

# ========================
# OS Generated
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========================
# Testing
# ========================
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ========================
# Logs
# ========================
logs/
*.log

# ========================
# Project CLI (scripts/cli/)
# ========================
scripts/.log/
scripts/cli/runner.config.json
scripts/cli/node_modules/
scripts/cli/dist/

# Local operator backups (Redis RDB, project snapshots)
backups/

# ========================
# Misc
# ========================
# Local sandbox (must not be committed)
tmp-toncore/

*.bak
*.tmp
*.temp
*.orig

# Local configuration
local.properties
*.local.yml
*.local.yaml

# Docker
docker-compose.override.yml
.docker/

# Terraform (if used for infrastructure)
*.tfstate
*.tfstate.*
.terraform/

# Generated documentation
docs/_build/
site/

# Temporary docs artifacts (agent/debug dumps — do not commit)
docs/_tmp_*
docs/**/_tmp_*

# i18n automation outputs (generated reports and translation batches)
i18n-report.json
reports/
scripts/i18n/*-patch.json
scripts/i18n/*-flat.json
scripts/i18n/*-missing*.json
scripts/i18n/*-overrides.json
scripts/i18n/*-ru-base.json

# SSL certificates for development (keep README)
certs/*.pem
certs/*.key
certs/*.crt
certs/*.p12
*.localhost.pem

# SSH keys
.ssh/*

# Python cache (utility scripts)
__pycache__/

# Local agent tool caches (never commit)
.claude/council-cache/
.claude/claude-council.local.md
