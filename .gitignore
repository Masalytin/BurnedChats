# BurnedChats .gitignore

# ========================
# Build artifacts & caches (do not commit)
# ========================
# Gradle — project root and any nested projects
.gradle/

# Backend (Spring / Gradle)
backend/build/
backend/bin/

# Frontend (Vite)
frontend/dist/
frontend/dist-ssr/

# Contracts (Node tooling; see also contracts/.gitignore)
contracts/build/

# Node — any package in the repo
node_modules/

# Catch-all for other tooling output (Vite cache, nested packages, etc.)
**/dist/
out/

# ========================
# IDE and Editor
# ========================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ========================
# Java / Gradle (artifacts not tied to one directory)
# ========================
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# JAR files (keep Gradle wrapper)
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Any other Gradle `build/` dirs (future modules) — after explicit paths above
**/build/
!gradle/wrapper/

# Maven (if ever used)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ========================
# TON contracts (contracts/) — env & tooling
# ========================
contracts/node_modules/
contracts/.env

# ========================
# Node.js logs & stores
# ========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next / Nuxt / caches
.next/
.nuxt/
.cache/

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.prod
*.env
!.env.example

# Let's Encrypt certificates
certbot/

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
*.jks
!certs/README.md

# ========================
# OS Generated
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========================
# Testing
# ========================
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ========================
# Logs
# ========================
logs/
*.log

# ========================
# Misc
# ========================
# Local sandbox (must not be committed)
tmp-toncore/

*.bak
*.tmp
*.temp
*.orig

# Local configuration
local.properties
*.local.yml
*.local.yaml

# Docker
docker-compose.override.yml
.docker/

# Terraform (if used for infrastructure)
*.tfstate
*.tfstate.*
.terraform/

# Generated documentation
docs/_build/
site/

# SSL certificates for development (keep README)
certs/*.pem
certs/*.key
certs/*.crt
certs/*.p12
*.localhost.pem

# SSH keys
.ssh/*
