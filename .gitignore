# BurnedChats .gitignore

# ========================
# IDE and Editor
# ========================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ========================
# Java / Gradle
# ========================
# Compiled class files
*.class

# Package files
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# JAR files (except gradle wrapper)
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Gradle
.gradle/
**/build/
!gradle/wrapper/

# Backend compiled output
backend/bin/

# Maven (if ever used)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# ========================
# Node.js / Frontend
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
**/dist/
out/
.next/
.nuxt/
.cache/

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# ========================
# Environment & Secrets
# ========================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.env
!.env.example

# Secrets
secrets/
*.pem
*.key
*.crt
*.p12
*.jks
!certs/README.md

# ========================
# OS Generated
# ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ========================
# Testing
# ========================
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ========================
# Logs
# ========================
logs/
*.log

# ========================
# Misc
# ========================
*.bak
*.tmp
*.temp
*.orig

# Local configuration
local.properties
*.local.yml
*.local.yaml

# Docker
docker-compose.override.yml
.docker/

# Terraform (if used for infrastructure)
*.tfstate
*.tfstate.*
.terraform/

# Generated documentation
docs/_build/
site/

# SSL certificates for development (keep README)
certs/*.pem
certs/*.key
certs/*.crt
certs/*.p12
*.localhost.pem


