# =============================================================================
# Blueprint wallet (--mnemonic scripts: deploy:burn:*, verify:deployment)
# https://docs.ton.org/contract-dev/blueprint/deploy#mnemonic-provider
# =============================================================================
WALLET_MNEMONIC=
# Tonkeeper testnet: v5r1 + SUBWALLET_NUMBER=0 + WALLET_NETWORK_ID=-3
# Legacy / other wallets: v4r2 (+ optional WALLET_ID=698983191)
WALLET_VERSION=v5r1
SUBWALLET_NUMBER=0
WALLET_NETWORK_ID=-3
# WALLET_ID=698983191

# Legacy aliases (mapped to WALLET_MNEMONIC before Blueprint starts; prefer WALLET_*)
MNEMONIC=
MNEMONIC_TESTNET=
MNEMONIC_MAINNET=

# Ton Center API keys — get one at https://toncenter.com
TONCENTER_API_KEY=
TONCENTER_API_KEY_TESTNET=

# =============================================================================
# BURN stack deploy (scripts/deploy.ts)
# =============================================================================
# Off-chain TEP-64 JSON (optional; default = https://burnedchats.net/jetton-metadata.json)
# Verify HTTP 200 before deploy: curl.exe -sfI "https://burnedchats.net/jetton-metadata.json"
# JETTON_METADATA_URI=https://burnedchats.net/jetton-metadata.json
JETTON_METADATA_URI=
INITIAL_MIN_PROPOSAL_VP=
TIMELOCK_DELAY_SEC=
VESTING_START=

# Lab tip only (IMP-TNFS-F02) — NEVER for shared tip / never leave Mini App on lab
# LAB_GOV_SHORT_TIMERS=1
# LAB_CANCEL_LAG_SEC=30
# LAB_PROPOSAL_PERIOD_SEC=60
# LAB_PROPOSAL_TIMELOCK_DELAY_SEC=60
# LAB_TIMELOCK_HIGH_VALUE_FLOOR_SEC=60   # Timelock high-value delay floor (IMP-MNAUD-F03); default = LAB_PROPOSAL_TIMELOCK_DELAY_SEC
# SKIP_SYNC_APP_CONFIGS=1          # optional; implied by LAB_GOV_SHORT_TIMERS=1
# FORCE_SYNC_APP_CONFIGS=1         # override — do not use for lab

# =============================================================================
# Timelock.governor = multisig (PARAMETERS_DECISION §2 B, 2026-08-08)
# Full notes: deployments/README.md § "Timelock governor multisig"
# =============================================================================
# Mainnet / MAINNET_FINALIZE=1: TIMELOCK_GOVERNOR is REQUIRED (multisig address).
# Ordinary lab: omit → Timelock.governor = deployer (WALLET_MNEMONIC).
# Lab tip with real multisig governor (agent-autonomous live tests): set address +
# throwaway testnet signer mnemonics (≥ threshold). Never put mainnet keys here.
# Harness (IMP-MNAUD-F15): resolveTimelockGovernorSender → EOA if governor==deployer,
# else ton-multisig-v2 order+approve. Redeploy lab after setting TIMELOCK_GOVERNOR.
TIMELOCK_GOVERNOR=
TIMELOCK_GOVERNOR_MULTISIG=
MULTISIG_KIND=ton-multisig-v2
MULTISIG_THRESHOLD=2
MULTISIG_SIGNER_1_MNEMONIC=
MULTISIG_SIGNER_2_MNEMONIC=
MULTISIG_SIGNER_3_MNEMONIC=
# MULTISIG_SIGNER_1_ADDRESS=
# MULTISIG_SIGNER_2_ADDRESS=
# MULTISIG_SIGNER_3_ADDRESS=

# Allocation holders (default: deployer). LP should be dedicated + excluded.
AIRDROP_MULTISIG=
LIQUIDITY_MULTISIG=

# Fee / staking smoke (IMP-TNFS-F06 Actor A model)
# Deploy / fund source = WALLET_MNEMONIC above (usually airdrop holder with BURN).
# Actor A = non-excluded signer for live stake/fee scenarios (mnemonic OR address).
# Recipient B = address only — no second mnemonic required.
# TEST_ACTOR_MNEMONIC=word1 word2 ...   # preferred; scenario runner uses this as Blueprint signer
# FEE_TEST_SENDER_MNEMONIC=...         # alias of TEST_ACTOR_MNEMONIC
# FEE_TEST_SENDER=0Q...                # optional address override (defaults to Actor A / airdropHolder)
# STAKE_TEST_SENDER=0Q...              # optional stake-sender override (defaults to FEE_TEST_SENDER)
# TEST_ACTOR=0Q...                     # optional address alias for Actor A
# FEE_TEST_RECIPIENT=0Q...             # required for fee-split: second non-excluded recipient (address only)
# BURN_SMOKE_TEST_OWNER=0Q...          # legacy alias for fee/stake sender
# fund-test-wallets budgets (IMP-TNFS-F08). Invoke directly — npm run swallows flags:
#   npx ts-node --transpile-only scripts/fund-test-wallets.ts --dry-run --manifest lab
# FUND_ACTOR_TON=35                    # full lab staking+gov run consumed ~30 TON live (2026-07-23)
# FUND_ACTOR_BURN=20
# FUND_RECIPIENT_TON=0.05
# FUND_JETTON_ATTACH=2.5               # BURN-leg attach; must be >= 2.1 (minTonFeePath) or exit 32113
# FEE_TEST_EXCLUDED_SENDER=0Q...  # optional; defaults to liquidityHolder (excluded regression)
# VERIFY_FEE_SPLIT_READONLY=1  # skip live sends; verify FEE_EXCLUDED_TX_HASH + airdrop fee config only
# FEE_SPLIT_TX_HASH=...        # verify existing fee-split tx after IMP-JETTON-FEE-01 redeploy
# FEE_EXCLUDED_TX_HASH=...     # optional override for excluded regression (default: REPORT §1 tx)

# Per-allocation vesting beneficiaries (default: deployer)
BENEFICIARY=
VESTING_BENEFICIARY_DEVELOPER=
VESTING_BENEFICIARY_ECOSYSTEM=
VESTING_BENEFICIARY_RESERVE=

# Partial deploy helpers (scripts/deployVesting.ts — addresses from deployments/*.json)
VESTING_ALLOC=
TIMELOCK=
TREASURY=
JETTON_MASTER=
STAKING_POOL=
