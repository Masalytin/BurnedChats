# =============================================================================
# Blueprint wallet (--mnemonic scripts: deploy:burn:*, verify:deployment)
# https://docs.ton.org/contract-dev/blueprint/deploy#mnemonic-provider
# =============================================================================
WALLET_MNEMONIC=
# Tonkeeper testnet: v5r1 + SUBWALLET_NUMBER=0 + WALLET_NETWORK_ID=-3
# Legacy / other wallets: v4r2 (+ optional WALLET_ID=698983191)
WALLET_VERSION=v5r1
SUBWALLET_NUMBER=0
WALLET_NETWORK_ID=-3
# WALLET_ID=698983191

# Legacy aliases (mapped to WALLET_MNEMONIC before Blueprint starts; prefer WALLET_*)
MNEMONIC=
MNEMONIC_TESTNET=
MNEMONIC_MAINNET=

# Ton Center API keys — get one at https://toncenter.com
TONCENTER_API_KEY=
TONCENTER_API_KEY_TESTNET=

# =============================================================================
# BURN stack deploy (scripts/deploy.ts)
# =============================================================================
JETTON_METADATA_URI=
INITIAL_MIN_PROPOSAL_VP=
TIMELOCK_DELAY_SEC=
VESTING_START=

# Testnet multisig placeholders (default: deployer wallet)
AIRDROP_MULTISIG=
LIQUIDITY_MULTISIG=

# Per-allocation vesting beneficiaries (default: deployer)
BENEFICIARY=
VESTING_BENEFICIARY_DEVELOPER=
VESTING_BENEFICIARY_ECOSYSTEM=
VESTING_BENEFICIARY_RESERVE=

# Partial deploy helpers (scripts/deployVesting.ts — addresses from deployments/*.json)
VESTING_ALLOC=
TIMELOCK=
TREASURY=
JETTON_MASTER=
STAKING_POOL=
