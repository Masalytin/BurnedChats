{
    "name": "contracts",
    "version": "0.0.1",
    "scripts": {
        "bp": "blueprint",
        "start": "blueprint run",
        "build": "blueprint build --all",
        "test": "jest --verbose",
        "test:coverage": "c8 --check-coverage --lines 80 --include \"wrappers/**/*.ts\" --include \"tests/helpers.ts\" --include \"tests/staking-helpers.ts\" npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "deploy:testnet": "blueprint run deployTestnet",
        "deploy:burn:testnet": "blueprint run deploy --testnet --mnemonic",
        "deploy:burn:mainnet": "blueprint run deploy --mainnet --mnemonic",
        "verify:deployment": "blueprint run verify-deployment --testnet --mnemonic",
        "sync:fee:testnet": "blueprint run syncFeeConfig --testnet --mnemonic",
        "sync:fee:mainnet": "blueprint run syncFeeConfig --mainnet --mnemonic",
        "deploy:mainnet": "blueprint run deployMainnet",
        "verify": "blueprint run verifyContract",
        "mint": "blueprint run mintPlaceholder",
        "release": "blueprint pack && npm publish --access public"
    },
    "dependencies": {
        "@ton/core": "~0"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@tact-lang/compiler": ">=1.6.13 <2.0.0",
        "@ton-community/func-js": ">=0.10.0",
        "@ton/blueprint": ">=0.40.0 <0.45.0",
        "@ton/crypto": "^3.3.0",
        "@ton/sandbox": ">=0.37.0",
        "@ton/test-utils": ">=0.11.0",
        "@ton/tolk-js": ">=1.0.0",
        "@ton/ton": ">=16.2.2 <17.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.17.2",
        "c8": "^10.1.3",
        "globals": "^17.5.0",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.38.0"
    },
    "engines": {
        "node": ">=18"
    }
}
