{
    "name": "contracts",
    "version": "0.0.1",
    "scripts": {
        "bp": "blueprint",
        "start": "blueprint run",
        "build": "blueprint build --all",
        "test": "jest --verbose",
        "test:coverage": "c8 --check-coverage --lines 80 --include \"wrappers/**/*.ts\" --include \"tests/helpers.ts\" --include \"tests/staking-helpers.ts\" npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "misti": "misti -A tact.config.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "deploy:testnet": "npm run build && blueprint run deployTestnet",
        "deploy:burn:testnet": "npm run build && blueprint run deploy --testnet --mnemonic",
        "deploy:burn:mainnet": "npm run build && blueprint run deploy --mainnet --mnemonic",
        "verify:deployment": "npm run testnet:scenarios -- --scenario fs-ops-deployment-fingerprint",
        "verify:fee-split:testnet": "npm run testnet:scenarios -- --scenario fs-jetton-fee-split",
        "testnet:scenarios": "ts-node --transpile-only testnet-scenarios/runner.ts",
        "fund:test-wallets": "ts-node --transpile-only scripts/fund-test-wallets.ts",
        "sync:fee:testnet": "npm run build && blueprint run syncFeeConfig --testnet --mnemonic",
        "sync:fee:mainnet": "npm run build && blueprint run syncFeeConfig --mainnet --mnemonic",
        "deploy:mainnet": "npm run build && blueprint run deployMainnet",
        "verify": "npm run build && blueprint run verifyContract",
        "mint": "npm run build && blueprint run mintPlaceholder",
        "release": "blueprint pack && npm publish --access public"
    },
    "dependencies": {
        "@ton/core": "~0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nowarp/misti": "0.9.0",
        "@tact-lang/compiler": "1.6.13",
        "@ton-community/func-js": ">=0.10.0",
        "@ton/blueprint": ">=0.40.0 <0.46.0",
        "@ton/crypto": "^3.3.0",
        "@ton/sandbox": ">=0.44.0",
        "@ton/test-utils": ">=0.11.0",
        "@ton/tolk-js": ">=1.4.2",
        "@ton/ton": ">=16.2.2 <17.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "c8": "^12.0.0",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0"
    },
    "engines": {
        "node": ">=18"
    }
}
