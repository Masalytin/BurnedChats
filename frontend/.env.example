# Ton Connect: manifest URL wallets fetch (HTTPS). Defaults to production if unset.
VITE_TONCONNECT_MANIFEST_URL=https://burnedchats.net/tonconnect-manifest.json

# --- BURN / TON (fill after testnet deploy — see contracts/deployments/testnet.json) ---
# Network: mainnet | testnet
VITE_TON_NETWORK=testnet
# Toncenter JSON-RPC base URL
VITE_TON_RPC_URL=https://testnet.toncenter.com/api/v2
# Do NOT put a Toncenter key here for production Mini App builds.
# VITE_* values are baked into the public JS bundle. Local/dev may leave this
# empty; backend Java uses TONCENTER_API_KEY from the server env instead.
# VITE_TONCENTER_API_KEY=

# BURN jetton master (friendly address)
VITE_BURN_JETTON_MASTER=
# Staking master contract
VITE_STAKING_MASTER=
# Governor contract
VITE_GOVERNOR_ADDRESS=
# Treasury contract
VITE_TREASURY_ADDRESS=

# Optional: native coin display ticker (default GRAM; set TON for legacy rollback)
VITE_NATIVE_COIN_SYMBOL=GRAM

# Backend API base (same origin in production; local dev example: http://localhost:8080)
VITE_API_URL=
